{
  "name": "outage under allow",
  "description": "A 5xx, a 429 and a malformed answer are all an outage: allow admits without a lease. Once Billing answers again the slice is leased as usual, and everything admitted is reported.",
  "config": { "failure_policy": "allow", "refill_threshold": 0 },
  "billing": {
    "POST /leases": [
      { "status": 503, "body": { "error": "unavailable" } },
      { "status": 429, "body": { "error": "Too Many Attempts." } },
      { "body": "not json" },
      { "body": { "lease_id": "lease_x", "expires_at": "2027-01-15T08:05:00+00:00", "granted": 100 } }
    ],
    "GET /entitlements/org_a": { "always": { "body": { "meters": {} } } },
    "POST /usage": [ { "body": { "ok": true, "accepted": 1, "regressed": 0, "ignored": 0 } } ]
  },
  "steps": [
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 50, "save": "r1", "expect": { "result": { "backed_by_lease": false, "grace": false } } },
    { "op": "can", "org": "org_a", "meter": "api", "n": 1000, "expect": { "result": true } },
    { "op": "advance", "seconds": 31 },
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 5, "save": "r2", "expect": { "result": { "backed_by_lease": false, "grace": false } } },
    { "op": "advance", "seconds": 31 },
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 5, "save": "r3", "expect": { "result": { "backed_by_lease": false, "grace": false } } },
    { "op": "advance", "seconds": 31 },
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 5, "save": "r4", "expect": { "result": { "backed_by_lease": true, "grace": false } } },
    { "op": "expect_requests", "requests": [
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } },
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } },
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } },
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } },
      { "route": "GET /entitlements/org_a" }
    ] },
    { "op": "commit", "ref": "r1", "actual": 50 },
    { "op": "commit", "ref": "r2", "actual": 5 },
    { "op": "commit", "ref": "r3", "actual": 5 },
    { "op": "commit", "ref": "r4", "actual": 5 },
    { "op": "balance", "org": "org_a", "meter": "api", "expect": { "result": 95 } },
    { "op": "report", "expect": { "result": 1 } },
    { "op": "expect_requests", "requests": [
      { "route": "POST /usage", "body": { "org": "org_a", "entries": [ { "meter": "api", "cumulative": 65, "seq": 4, "epoch": 1800000093000 } ] } }
    ] }
  ]
}
