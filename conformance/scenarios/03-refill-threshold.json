{
  "name": "top-up at the threshold",
  "description": "A reservation that leaves more than refill_threshold units asks nothing; one that leaves exactly the threshold tops the slice up.",
  "config": { "lease_size": 100, "refill_threshold": 20 },
  "billing": {
    "POST /leases": [
      { "body": { "lease_id": "lease_1", "granted": 100, "expires_at": "2027-01-15T08:05:00+00:00" } },
      { "body": { "lease_id": "lease_2", "granted": 100, "expires_at": "2027-01-15T08:05:00+00:00" } }
    ],
    "GET /entitlements/org_a": { "always": { "body": { "meters": {
      "api": { "enabled": true, "allowance": 1000, "weight": 0.5, "overage": "block" }
    } } } }
  },
  "steps": [
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 79, "save": "r1" },
    { "op": "balance", "org": "org_a", "meter": "api", "expect": { "result": 21 } },
    { "op": "expect_requests", "requests": [
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } },
      { "route": "GET /entitlements/org_a" }
    ] },
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 1, "save": "r2" },
    { "op": "expect_requests", "requests": [
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } }
    ] },
    { "op": "balance", "org": "org_a", "meter": "api", "expect": { "result": 120 } }
  ]
}
