{
  "name": "outage under deny",
  "description": "deny refuses with BillingUnavailable once the slice is spent. The breaker keeps later reservations from waiting on Billing; after it cools down the next one tries again. A 408 is an outage too.",
  "config": { "failure_policy": "deny" },
  "billing": {
    "POST /leases": [
      { "network_error": true },
      { "status": 408, "body": { "error": "timeout" } }
    ]
  },
  "steps": [
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 1, "expect": { "error": "BillingUnavailable" } },
    { "op": "can", "org": "org_a", "meter": "api", "n": 1, "expect": { "result": false } },
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 1, "expect": { "error": "BillingUnavailable" } },
    { "op": "reserve_many", "org": "org_a", "meters": { "api": 1, "tokens": 1 }, "expect": { "error": "BillingUnavailable" } },
    { "op": "expect_requests", "requests": [
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } }
    ] },
    { "op": "advance", "seconds": 31 },
    { "op": "reserve", "org": "org_a", "meter": "api", "estimate": 1, "expect": { "error": "BillingUnavailable" } },
    { "op": "expect_requests", "requests": [
      { "route": "POST /leases", "body": { "org": "org_a", "meter": "api", "size": 100 } }
    ] }
  ]
}
