{
  "name": "a set is held all or nothing",
  "description": "Meters in a set are held in key order. When one cannot be held, those already held go back and the set fails as one. A commit must name every meter with an actual in range, or nothing moves. A set committed with one number, or a single reservation with a map, is refused too.",
  "config": {
    "refill_threshold": 0
  },
  "billing": {
    "POST /leases": [
      {
        "body": {
          "lease_id": "lease_x",
          "expires_at": "2027-01-15T08:05:00+00:00",
          "granted": 100
        }
      },
      {
        "body": {
          "lease_id": "lease_x",
          "expires_at": "2027-01-15T08:05:00+00:00",
          "granted": 0
        }
      },
      {
        "body": {
          "lease_id": "lease_x",
          "expires_at": "2027-01-15T08:05:00+00:00",
          "granted": 100
        }
      }
    ],
    "GET /entitlements/org_a": {
      "always": {
        "body": {
          "meters": {}
        }
      }
    }
  },
  "steps": [
    {
      "op": "reserve_many",
      "org": "org_a",
      "meters": {
        "tokens": 5,
        "api": 10
      },
      "expect": {
        "error": "QuotaExceeded",
        "reason": "quota_exhausted"
      }
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 100
      }
    },
    {
      "op": "reserve_many",
      "org": "org_a",
      "meters": {
        "tokens": 5,
        "api": 10
      },
      "save": "s1",
      "expect": {
        "result": {
          "buckets": {
            "api": {
              "backed_by_lease": true,
              "grace": false
            },
            "tokens": {
              "backed_by_lease": true,
              "grace": false
            }
          }
        }
      }
    },
    {
      "op": "expect_requests",
      "requests": [
        {
          "route": "POST /leases",
          "body": {
            "org": "org_a",
            "meter": "api",
            "size": 100
          }
        },
        {
          "route": "GET /entitlements/org_a"
        },
        {
          "route": "POST /leases",
          "body": {
            "org": "org_a",
            "meter": "tokens",
            "size": 100
          }
        },
        {
          "route": "POST /leases",
          "body": {
            "org": "org_a",
            "meter": "tokens",
            "size": 100
          }
        }
      ]
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 90
      }
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "tokens",
      "expect": {
        "result": 95
      }
    },
    {
      "op": "commit",
      "ref": "s1",
      "actual": 3,
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "commit",
      "ref": "s1",
      "actual": {
        "api": 3
      },
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "commit",
      "ref": "s1",
      "actual": {
        "api": 3,
        "tokens": 6
      },
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 90
      }
    },
    {
      "op": "commit",
      "ref": "s1",
      "actual": {
        "api": 3,
        "tokens": 5
      }
    },
    {
      "op": "release",
      "ref": "s1"
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 97
      }
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "tokens",
      "expect": {
        "result": 95
      }
    },
    {
      "op": "expect_requests",
      "requests": []
    }
  ]
}
