{
  "name": "a reservation settles once",
  "description": "A second commit, or a commit after a release, is an invalid argument and moves nothing. A release after settling does nothing, so release in a finally block is safe. An out-of-range actual is refused and leaves the reservation open.",
  "config": {},
  "billing": {
    "POST /leases": [
      {
        "body": {
          "lease_id": "lease_1",
          "granted": 100,
          "expires_at": "2027-01-15T08:05:00+00:00"
        }
      }
    ],
    "GET /entitlements/org_a": {
      "always": {
        "body": {
          "meters": {}
        }
      }
    },
    "POST /usage": [
      {
        "body": {
          "ok": true,
          "accepted": 1,
          "regressed": 0,
          "ignored": 0
        }
      }
    ]
  },
  "steps": [
    {
      "op": "reserve",
      "org": "org_a",
      "meter": "api",
      "estimate": 10,
      "save": "r1"
    },
    {
      "op": "commit",
      "ref": "r1",
      "actual": 4
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 96
      }
    },
    {
      "op": "commit",
      "ref": "r1",
      "actual": 4,
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "release",
      "ref": "r1"
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 96
      }
    },
    {
      "op": "reserve",
      "org": "org_a",
      "meter": "api",
      "estimate": 10,
      "save": "r2"
    },
    {
      "op": "release",
      "ref": "r2"
    },
    {
      "op": "release",
      "ref": "r2"
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 96
      }
    },
    {
      "op": "commit",
      "ref": "r2",
      "actual": 1,
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "reserve",
      "org": "org_a",
      "meter": "api",
      "estimate": 10,
      "save": "r3"
    },
    {
      "op": "commit",
      "ref": "r3",
      "actual": {
        "api": 1
      },
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "commit",
      "ref": "r3",
      "actual": 11,
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "commit",
      "ref": "r3",
      "actual": -1,
      "expect": {
        "error": "InvalidArgument"
      }
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 86
      }
    },
    {
      "op": "commit",
      "ref": "r3",
      "actual": 10
    },
    {
      "op": "balance",
      "org": "org_a",
      "meter": "api",
      "expect": {
        "result": 86
      }
    },
    {
      "op": "report",
      "expect": {
        "result": 1
      }
    },
    {
      "op": "expect_requests",
      "requests": [
        {
          "route": "POST /leases",
          "body": {
            "org": "org_a",
            "meter": "api",
            "size": 100
          }
        },
        {
          "route": "GET /entitlements/org_a"
        },
        {
          "route": "POST /usage",
          "body": {
            "org": "org_a",
            "entries": [
              {
                "meter": "api",
                "cumulative": 14,
                "seq": 2,
                "epoch": 1800000000000
              }
            ]
          }
        }
      ]
    }
  ]
}
